# arXiv Parser 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置

# ============ LLM API Keys ============

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ============ 可选配置 ============

# MCP server 使用的 Python 解释器绝对路径
# 换机器部署时改这里即可；留空则自动探测标准 conda 目录（~/miniconda3/envs/arxiv_parser）
ARXIV_PARSER_PYTHON=/home/yourname/miniconda3/envs/arxiv_parser/bin/python3

# Ollama 本地服务地址（如果使用本地模型）
OLLAMA_BASE_URL=http://localhost:11434

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
